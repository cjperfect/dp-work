# ============================================================
# api 服务（services/api，:8000）环境变量模板
# 使用：cp .env.example .env 后按需修改（服务启动时自动加载本目录 .env）
# ============================================================

# PostgreSQL 业务数据库连接串，包含账号、密码、服务器地址、端口和库名。
DATABASE_URL=postgresql+asyncpg://chenjiang:chenjiang@127.0.0.1:5432/dp_work

# JWT 签名密钥；生产环境使用强随机值，多个 API 实例保持一致。
JWT_SECRET=dp-dev-insecure-secret-change-me
# JWT 签名算法，当前使用 HS256。
JWT_ALG=HS256
# 登录令牌有效期，单位秒；604800 表示一周。
JWT_TTL_SECONDS=604800

# 启动时是否创建缺省管理员：1 开启，0 关闭；已有账号不重置。
BOOTSTRAP_ADMIN_ENABLED=1
# 首次创建缺省管理员时使用的用户名。
BOOTSTRAP_ADMIN_USERNAME=chenjiang
# 首次创建缺省管理员时使用的密码；生产环境应自行设置。
BOOTSTRAP_ADMIN_PASSWORD=chenjiang

# 允许访问 API 和生成状态 WebSocket 的页面来源，多个地址用逗号分隔。
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3300,http://127.0.0.1:3300

# 登录密码传输的 RSA 私钥文件路径；未配置时使用默认路径，多实例需共享同一私钥。
# CREDENTIAL_PRIVATE_KEY_FILE=/secure/keys/auth-transport.pem

# API 调用 Sidecar 内部生成接口的 HTTP 服务地址。
SIDECAR_API_URL=http://127.0.0.1:8001
# API 与 Sidecar 之间的服务鉴权密钥；两个服务填写相同值，不提供给前端。
SIDECAR_INTERNAL_TOKEN=
# API 等待 Sidecar 生成结果的总超时，单位秒，应大于 Sidecar 的模型调用超时。
MINUTES_TASK_TIMEOUT=210
# 是否在 API 进程内启动纪要任务执行器：1 开启，0 关闭。
MINUTES_WORKER_ENABLED=1

# 是否启动文档解析后台任务（1 开启、0 关闭）
DOCUMENT_PARSE_WORKER_ENABLED=1

# 单个文档解析任务最长等待秒数
DOCUMENT_PARSE_TIMEOUT=1200

# Agent 流式请求最长等待秒数，应大于 Sidecar 的 ARK_TIMEOUT_SECONDS。
AGENT_REQUEST_TIMEOUT=210

# 是否运行知识库向量化任务（1 开启，0 关闭）。
DOCUMENT_VECTOR_WORKER_ENABLED=1
