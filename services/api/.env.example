# ============================================================
# api 服务（services/api，:8000）环境变量模板
# 使用：cp .env.example .env 后按需修改（服务启动时自动加载本目录 .env）
# ============================================================

# PostgreSQL 连接串（与 docker-compose / infra 的 POSTGRES_* 保持一致）
DATABASE_URL=postgresql://chenjiang:chenjiang@localhost:5432/dp_work

# JWT 签发密钥（生产环境务必更换为强随机值：openssl rand -hex 32）
JWT_SECRET=dp-dev-insecure-secret-change-me
JWT_ALG=HS256
# 令牌有效期（秒），默认一周
JWT_TTL_SECONDS=604800

# 启动时创建初始管理员；已存在的账号不会被覆盖
BOOTSTRAP_ADMIN_ENABLED=1
BOOTSTRAP_ADMIN_USERNAME=chenjiang
BOOTSTRAP_ADMIN_PASSWORD=chenjiang

# 允许跨域来源，逗号分隔
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# 登录/注册 JWE 解密私钥路径，可选；默认自动生成至仓库 .dp-work/keys/auth-transport.pem
# 多实例应挂载同一份私钥，仅服务端可读；不要提交到 Git 或放入 Web 的公开目录
# CREDENTIAL_PRIVATE_KEY_FILE=/secure/keys/auth-transport.pem
