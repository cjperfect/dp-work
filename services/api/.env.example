# ============================================================
# api 服务（services/api，:8000）环境变量模板
# 使用：cp .env.example .env 后按需修改（服务启动时自动加载本目录 .env）
# ============================================================

# PostgreSQL 业务数据库连接串，包含账号、密码、服务器地址、端口和库名。
DATABASE_URL=postgresql+asyncpg://chenjiang:chenjiang@127.0.0.1:5432/dp_work

# JWT 签名密钥；生产环境使用强随机值，多个 API 实例保持一致。
JWT_SECRET=dp-dev-insecure-secret-change-me
# JWT 签名算法，当前使用 HS256。
JWT_ALG=HS256
# 登录令牌有效期，单位秒；604800 表示一周。
JWT_TTL_SECONDS=604800

# 启动时是否创建缺省管理员：1 开启，0 关闭；已有账号不重置。
BOOTSTRAP_ADMIN_ENABLED=1
# 首次创建缺省管理员时使用的用户名。
BOOTSTRAP_ADMIN_USERNAME=chenjiang
# 首次创建缺省管理员时使用的密码；生产环境应自行设置。
BOOTSTRAP_ADMIN_PASSWORD=chenjiang

# 允许访问 API 和生成状态 WebSocket 的页面来源，多个地址用逗号分隔。
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3300,http://127.0.0.1:3300,http://127.0.0.1:34731,http://localhost:34731

# 登录密码传输的 RSA 私钥文件路径；未配置时使用默认路径，多实例需共享同一私钥。
# CREDENTIAL_PRIVATE_KEY_FILE=/secure/keys/auth-transport.pem

# 执行服务传输方式：device 为用户设备主动连接，http 仅供集中式开发兼容。
SIDECAR_TRANSPORT=device
# 仅 http 模式直接调用此地址；device 模式不连接云端回环端口。
SIDECAR_API_URL=http://127.0.0.1:8001
# 仅 http 兼容模式需要与服务端 Sidecar 一致；device 模式不向客户端分发此密钥。
SIDECAR_INTERNAL_TOKEN=
# API 等待 Sidecar 生成结果的总超时，单位秒，应大于 Sidecar 的模型调用超时。
MINUTES_TASK_TIMEOUT=210
# 是否允许独立 Celery Worker 执行纪要任务：1 开启，0 关闭。
MINUTES_WORKER_ENABLED=1

# 是否允许独立 Celery Worker 执行文档解析（1 开启、0 关闭）。
DOCUMENT_PARSE_WORKER_ENABLED=1

# 单个文档解析任务最长等待秒数
DOCUMENT_PARSE_TIMEOUT=1200

# Agent 流式请求最长等待秒数，应大于 Sidecar 的 ARK_TIMEOUT_SECONDS。
AGENT_REQUEST_TIMEOUT=210

# 是否允许独立 Celery Worker 执行向量化（1 开启，0 关闭）。
DOCUMENT_VECTOR_WORKER_ENABLED=1

# 是否开启 Elasticsearch 关键词检索及索引同步（1 开启，0 仅使用 pgvector）。
ELASTICSEARCH_ENABLED=1
# Elasticsearch 服务地址；Docker Compose 的开发端口仅监听本机。
ELASTICSEARCH_URL=http://127.0.0.1:9200
# 关键词索引名；修改分析器或映射时使用新版本名，后台会从 PG 重建。
ELASTICSEARCH_INDEX=dp-work-knowledge-v1
# 生产环境 Elasticsearch API Key，与用户名密码二选一；密钥仅在服务端使用。
ELASTICSEARCH_API_KEY=
# 使用 Basic 鉴权时填写的用户名。
ELASTICSEARCH_USERNAME=
# 使用 Basic 鉴权时填写的密码。
ELASTICSEARCH_PASSWORD=
# HTTPS 私有证书 CA 文件路径；留空使用系统证书校验，不关闭 TLS 校验。
ELASTICSEARCH_CA_FILE=
# 单次 Elasticsearch 请求超时秒数。
ELASTICSEARCH_TIMEOUT=5
# 两路各自召回的子块数量，融合后按父块去重。
RAG_HYBRID_CANDIDATES=50
# RRF 平滑常数。
RAG_RRF_CONSTANT=60

# RabbitMQ AMQP 连接地址；仅服务端使用，生产环境替换专用账号与连接地址。
MQ_BROKER_URL=amqp://chenjiang:chenjiang@127.0.0.1:5672/dp-work
# 是否启用 API 的消息投递器；关闭后仍保留待投递消息。
MQ_DISPATCH_ENABLED=1
# 消息已投递但未完成时的补投间隔（秒）。
MQ_REDELIVERY_SECONDS=300
# Celery 单任务硬超时（秒），需覆盖完整向量化任务。
MQ_TASK_TIME_LIMIT=3600
# 会议纪要 Worker 并发数。
MQ_MINUTES_CONCURRENCY=2
# 文档解析 Worker 并发数。
MQ_PARSE_CONCURRENCY=2
# 向量化 Worker 并发数。
MQ_VECTOR_CONCURRENCY=2
# ES 索引同步 Worker 并发数。
MQ_SEARCH_CONCURRENCY=1
# Worker 进程池：留空自动选择，macOS 为多组 solo，Linux 为 prefork。
MQ_WORKER_POOL=
