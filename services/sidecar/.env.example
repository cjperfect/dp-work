# ============================================================
# sidecar 服务（services/sidecar，:8001）环境变量模板
# 使用：cp .env.example .env 后按需修改（服务启动时自动加载本目录 .env）
# ============================================================

# 本地数据目录（SQLite / 音频缓存）；留空 = 仓库根目录 .dp-work/data
# 生产 Electron：传用户数据目录（如 ~/Library/Application Support/dp-work/data）
DP_DATA_DIR=

# 上行同步到 api 的配置
SYNC_API_BASE=http://localhost:8000
SYNC_INTERVAL_SEC=5
SYNC_BATCH_SIZE=200

# ASR：1 = mock 流（开发联调），0 = 接真实豆包流式 ASR（需 VOLC_* 凭证）
MOCK_ASR=1
# 豆包流式 ASR 凭证（MOCK_ASR=0 时必填）
# VOLC_ACCESSKEY=
# VOLC_SECRETKEY=
# VOLC_APPID=
# VOLC_CLUSTER=
