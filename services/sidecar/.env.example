# ============================================================
# sidecar 服务（services/sidecar，:8001）环境变量模板
# 使用：cp .env.example .env 后按需修改（服务启动时自动加载本目录 .env）
# ============================================================

# Sidecar 用此路径定位同级 temp 目录；留空使用仓库 .dp-work/temp，不创建 SQLite。
DP_DATA_DIR=

# 豆包流式 ASR 的 API Key，仅供服务端使用，与方舟模型 Key 分开配置。
VOLC_API_KEY=
# 豆包 ASR 的完整 WebSocket 接口地址，必须使用 wss://。
VOLC_BASE_URL=wss://openspeech.bytedance.com/api/v3/sauc/bigmodel_async

# 豆包 ASR 资源 ID，需与控制台开通的服务类型一致。
VOLC_RESOURCE_ID=volc.seedasr.sauc.duration


# 方舟大模型 API Key，仅服务端读取，Agent 与会议纪要共用；不要提交真实密钥。
ARK_API_KEY=
# 方舟模型 ID 或推理接入点 ID，Agent 与会议纪要共用。
ARK_MODEL=deepseek-v4-1-flash-261017
# 方舟 API 基础地址，必须使用 HTTPS，不包含 /chat/completions 后缀。
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# 单次方舟模型调用的总超时，单位秒。
ARK_TIMEOUT_SECONDS=180
# 单次模型请求的输出 token 上限，输出被截断时不作为成功纪要保存。
ARK_MAX_TOKENS=8192
# 纪要输入资料的最大字符数，超出时提示错误，不静默截断。
MINUTES_MAX_INPUT_CHARS=120000
# API 与 Sidecar 之间的服务鉴权密钥；两个服务填写相同值，不提供给前端。
SIDECAR_INTERNAL_TOKEN=

# PDF 解析进程超时时间（秒）
PDF_PARSE_TIMEOUT=90

# 百度通用文字识别高精度版凭证，仅 PDF 无文字层页面使用，不提供给前端。
BAIDU_OCR_API_KEY=
BAIDU_OCR_SECRET_KEY=
# 单次百度鉴权或 OCR 请求超时秒数；整个解析仍受 PDF_PARSE_TIMEOUT 限制。
BAIDU_OCR_TIMEOUT_SECONDS=20
# 单个 PDF 最多调用 OCR 的页数；超出则要求拆分，不静默丢弃页面。
BAIDU_OCR_MAX_PAGES=20

# 单次 Agent 执行循环预算；内部图节点上限为该值 × 6 + 8，计入中间件节点，防止无限循环。
AGENT_MAX_STEPS=12
# 相同工具、参数、结果连续重复 3 次后，阻止第 4 次相同调用。
AGENT_REPEAT_LIMIT=3
# 工具连续返回明确 error 状态的次数上限。
AGENT_TOOL_ERROR_LIMIT=5
# Windows 命令隔离：Docker Desktop 使用 Linux 容器；填写本机镜像 sha256 ID，留空禁用 execute。
# 构建方法见 src/tools/README.md；不会在 Agent 执行时下载镜像。
AGENT_SANDBOX_IMAGE=
# 整个 Agent 任务累计 Token 预算；0 不限制，达到后阻止下一次模型调用。
AGENT_RUN_TOKEN_LIMIT=0
# 整个任务费用预算；0 不限制，启用前需填写当前模型单价。已发出的请求可能超出预算。
AGENT_RUN_COST_LIMIT=0
# 费用估算统一币种，仅用于本机展示，不代表服务商账单。
AGENT_COST_CURRENCY=CNY
# 模型 ID -> 每百万 Token 单价（input/output 必填，cached_input 可选；缺省按普通输入计价）。
# 例如结构：{"模型ID":{"input":实际输入单价,"output":实际输出单价,"cached_input":实际缓存单价}}；留空对象只统计 Token。
AGENT_MODEL_PRICES={}

# 知识库 Embedding 密钥；单独配置，可填写具有该模型权限的方舟 API Key。
EMBEDDING_API_KEY=
# 知识库向量模型 ID。
EMBEDDING_MODEL=doubao-embedding-vision-251215
# 方舟向量服务 Base URL，不包含 /embeddings/multimodal。
EMBEDDING_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# 向量维度，与 PostgreSQL 索引一致；当前固定为 1024。
EMBEDDING_DIMENSIONS=1024
# 单次向量服务请求超时秒数。
EMBEDDING_TIMEOUT_SECONDS=30
# Sidecar 检索 Tool 调用的 API 内部地址。
API_INTERNAL_URL=http://127.0.0.1:8000

# 启用本机后台记忆生成；账号仍可在设置中单独关闭，0 为全局关闭。
MEMORY_AUTO_ENABLED=1
# 会话空闲多少小时后才提取，默认 6；不在每轮回复结束时立即生成。
MEMORY_IDLE_HOURS=6
# 后台扫描间隔秒数（最小 10）；没有符合条件的会话不会调用模型。
MEMORY_SCAN_SECONDS=60
# 只考虑最近多少天内更新的会话（1–90）。
MEMORY_MAX_AGE_DAYS=30
# 每次扫描最多处理的会话数（1–16），并发固定为 1。
MEMORY_BATCH_SIZE=4
# 单会话提取模型 ID；留空沿用当前账号个人模型或 ARK_MODEL。
MEMORY_EXTRACT_MODEL=
# 记忆合并模型 ID；留空沿用当前账号个人模型或 ARK_MODEL。
MEMORY_CONSOLIDATION_MODEL=

# 长期记忆复用上方 EMBEDDING_* 配置；最低余弦相似度，范围 -1 到 1。
MEMORY_MIN_SIMILARITY=0.25
# 记忆索引及检索超时（秒），超时后回退到范围加载，不阻断聊天。
MEMORY_RETRIEVAL_TIMEOUT_SECONDS=10

# ASR 每小时单价，与 AGENT_COST_CURRENCY 同币种；为空时只显示音频时长。
ASR_PRICE_PER_HOUR=

# ===== 开发离线评测：仅 evals/run.py 使用，不开启生产会话上传 =====
# LangSmith API Key；仅显式运行 --upload 时使用，不提供给前端。
LANGSMITH_API_KEY=
# LangSmith API 地址；欧洲区或自托管时按实际服务配置。
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# 不开启全局生产追踪，评测命令通过 --upload 单独控制上传。
LANGSMITH_TRACING=false
