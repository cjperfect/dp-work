# ============================================================
# sidecar 服务（services/sidecar，:8001）环境变量模板
# 使用：cp .env.example .env 后按需修改（服务启动时自动加载本目录 .env）
# ============================================================

# Sidecar 用此路径定位同级 temp 目录；留空使用仓库 .dp-work/temp，不创建 SQLite。
DP_DATA_DIR=

# 豆包流式 ASR 的 API Key，仅供服务端使用，与方舟模型 Key 分开配置。
VOLC_API_KEY=
# 豆包 ASR 的完整 WebSocket 接口地址，必须使用 wss://。
VOLC_BASE_URL=wss://openspeech.bytedance.com/api/v3/sauc/bigmodel_async

# 豆包 ASR 资源 ID，需与控制台开通的服务类型一致。
VOLC_RESOURCE_ID=volc.seedasr.sauc.duration


# 火山方舟大模型的 API Key，仅供服务端使用，独立于 ASR 凭证。
ARK_API_KEY=
# 方舟大模型的模型 ID 或推理接入点 ID，需在账号下可访问。
ARK_MODEL=deepseek-v4-1-flash-261017
# 方舟模型 API 基础地址，使用 HTTPS，不包含 /chat/completions 后缀。
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# 单次方舟模型调用的总超时，单位秒。
ARK_TIMEOUT_SECONDS=180
# 单次模型请求的输出 token 上限，输出被截断时不作为成功纪要保存。
ARK_MAX_TOKENS=8192
# 纪要输入资料的最大字符数，超出时提示错误，不静默截断。
MINUTES_MAX_INPUT_CHARS=120000
# API 与 Sidecar 之间的服务鉴权密钥；两个服务填写相同值，不提供给前端。
SIDECAR_INTERNAL_TOKEN=

# PDF 解析进程超时时间（秒）
PDF_PARSE_TIMEOUT=90
