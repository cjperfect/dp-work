# ============================================================
# sidecar 服务（services/sidecar，:8001）环境变量模板
# 使用：cp .env.example .env 后按需修改（服务启动时自动加载本目录 .env）
# ============================================================

# Sidecar 用此路径定位同级 temp 目录；留空使用仓库 .dp-work/temp，不创建 SQLite。
DP_DATA_DIR=

# 豆包流式 ASR 的 API Key，仅供服务端使用，与方舟模型 Key 分开配置。
VOLC_API_KEY=
# 豆包 ASR 的完整 WebSocket 接口地址，必须使用 wss://。
VOLC_BASE_URL=wss://openspeech.bytedance.com/api/v3/sauc/bigmodel_async

# 豆包 ASR 资源 ID，需与控制台开通的服务类型一致。
VOLC_RESOURCE_ID=volc.seedasr.sauc.duration


# 方舟大模型 API Key，仅服务端读取，Agent 与会议纪要共用；不要提交真实密钥。
ARK_API_KEY=
# 方舟模型 ID 或推理接入点 ID，Agent 与会议纪要共用。
ARK_MODEL=deepseek-v4-1-flash-261017
# 方舟 API 基础地址，必须使用 HTTPS，不包含 /chat/completions 后缀。
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# 单次方舟模型调用的总超时，单位秒。
ARK_TIMEOUT_SECONDS=180
# 单次模型请求的输出 token 上限，输出被截断时不作为成功纪要保存。
ARK_MAX_TOKENS=8192
# 纪要输入资料的最大字符数，超出时提示错误，不静默截断。
MINUTES_MAX_INPUT_CHARS=120000
# API 与 Sidecar 之间的服务鉴权密钥；两个服务填写相同值，不提供给前端。
SIDECAR_INTERNAL_TOKEN=

# PDF 解析进程超时时间（秒）
PDF_PARSE_TIMEOUT=90

# 单次 Agent 执行的图节点步数上限，防止工具调用无限循环。
AGENT_MAX_STEPS=12

# 知识库 Embedding 密钥；单独配置，可填写具有该模型权限的方舟 API Key。
EMBEDDING_API_KEY=
# 知识库向量模型 ID。
EMBEDDING_MODEL=doubao-embedding-vision-251215
# 方舟向量服务 Base URL，不包含 /embeddings/multimodal。
EMBEDDING_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# 向量维度，与 PostgreSQL 索引一致；当前固定为 1024。
EMBEDDING_DIMENSIONS=1024
# 单次向量服务请求超时秒数。
EMBEDDING_TIMEOUT_SECONDS=30
# Sidecar 检索 Tool 调用的 API 内部地址。
API_INTERNAL_URL=http://127.0.0.1:8000
