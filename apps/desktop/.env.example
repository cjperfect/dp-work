# Electron 开发模式加载的 Web 页面地址，复用已启动的前端服务。
DESKTOP_WEB_URL=http://localhost:3000/
# Electron 内置 Web 服务的固定端口，用于保持客户端页面来源稳定。
DESKTOP_WEB_PORT=34731

# Electron 内置代理访问的 API 服务地址；打包时记录，运行时可用同名变量覆盖。
DESKTOP_API_BASE_URL=http://127.0.0.1:8000

# 是否由 Electron 管理本机 Sidecar：开发及安装版默认 1，安装版使用内置独立程序。
DESKTOP_SIDECAR_ENABLED=1
# Sidecar 本机 ASR WebSocket 端口，需与 Web ASR 配置一致；普通业务使用 stdio RPC。
DESKTOP_SIDECAR_PORT=8001
# 可选：Sidecar 源码/运行目录；开发默认 services/sidecar，安装版默认 resources/sidecar。
# DESKTOP_SIDECAR_ROOT=/absolute/path/to/sidecar
# 可选：Python 路径；默认使用 Sidecar 目录下的 .venv，不使用系统 Python。
# DESKTOP_SIDECAR_PYTHON=/absolute/path/to/python
# 可选：独立打包的 Sidecar 可执行程序，与 Python 启动方式二选一，通过 PORT 环境变量接收端口。
# DESKTOP_SIDECAR_EXECUTABLE=/absolute/path/to/dp-work-sidecar
