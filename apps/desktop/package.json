{
  "name": "@dp-work/desktop",
  "version": "0.1.1",
  "private": true,
  "description": "企业 Agent 平台桌面客户端",
  "author": "DP Work",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "pnpm build && node scripts/dev.mjs",
    "build": "pnpm --filter @dp-work/protocols build && tsc -p tsconfig.json",
    "typecheck": "pnpm --filter @dp-work/protocols build && tsc -p tsconfig.json --noEmit",
    "build:web": "node scripts/prepare-web.mjs",
    "start": "electron .",
    "preview": "pnpm build && node scripts/preview.mjs",
    "package": "pnpm build && pnpm build:web && pnpm build:sidecar && electron-builder --publish never",
    "package:dir": "pnpm build && pnpm build:web && pnpm build:sidecar && electron-builder --dir --publish never",
    "test": "pnpm --filter @dp-work/protocols build && tsx --test tests/*.test.ts",
    "build:sidecar": "node scripts/prepare-sidecar.mjs",
    "smoke:sidecar": "node scripts/smoke-sidecar.mjs"
  },
  "dependencies": {
    "@dp-work/protocols": "workspace:*",
    "electron-updater": "6.8.12"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "electron": "45.0.0",
    "electron-builder": "26.18.0",
    "js-yaml": "^4.3.2",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^6.0.0"
  },
  "build": {
    "appId": "com.dpwork.desktop",
    "productName": "DP Work",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "resources/icon.png",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build",
        "to": ".",
        "filter": [
          "web/**/*",
          "web-config.json"
        ]
      },
      {
        "from": "build/sidecar",
        "to": "sidecar",
        "filter": [
          "**/*",
          "!**/.env",
          "!**/.env.*"
        ]
      }
    ],
    "mac": {
      "icon": "resources/icon.icns",
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "zip"
      ],
      "extendInfo": {
        "NSMicrophoneUsageDescription": "用于会议录音和实时语音转写。"
      },
      "entitlements": "resources/entitlements.mac.plist",
      "entitlementsInherit": "resources/entitlements.mac.plist",
      "binaries": [
        "Contents/Resources/sidecar/dp-work-sidecar"
      ],
      "hardenedRuntime": true
    },
    "win": {
      "icon": "resources/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "icon": "resources/icon.png",
      "target": [
        "AppImage"
      ],
      "category": "Office"
    },
    "artifactName": "DP-Work-${version}-${os}-${arch}.${ext}",
    "publish": [
      {
        "provider": "github",
        "owner": "cjperfect",
        "repo": "dp-work",
        "releaseType": "draft"
      }
    ]
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
