{
  "name": "@dp-work/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "企业 Agent 平台桌面客户端",
  "author": "DP Work",
  "main": "dist/main.js",
  "scripts": {
    "dev": "pnpm build && node scripts/dev.mjs",
    "build": "pnpm --filter @dp-work/contracts build && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build:web": "node scripts/prepare-web.mjs",
    "start": "electron .",
    "preview": "pnpm build && node scripts/preview.mjs",
    "package": "pnpm build && pnpm build:web && electron-builder",
    "package:dir": "pnpm build && pnpm build:web && electron-builder --dir",
    "test": "tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@dp-work/contracts": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "electron": "45.0.0",
    "electron-builder": "26.18.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^6.0.0"
  },
  "build": {
    "appId": "com.dpwork.desktop",
    "productName": "DP Work",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build",
        "to": ".",
        "filter": [
          "web/**/*",
          "web-config.json"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg"
      ],
      "extendInfo": {
        "NSMicrophoneUsageDescription": "用于会议录音和实时语音转写。"
      },
      "entitlements": "resources/entitlements.mac.plist",
      "entitlementsInherit": "resources/entitlements.mac.plist"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Office"
    }
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
