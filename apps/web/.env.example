# ============================================================
# Web（apps/web）环境变量模板
# 使用：cp .env.example .env.local 后按需修改（Next.js 自动加载 .env.local）
# 仅 WEB 包相关变量放在这里，api / sidecar 各自管理自己的 .env
# ============================================================

# 企业 API 地址（Next.js 将 /api/v1 代理到该地址）
API_BASE_URL=http://127.0.0.1:8000

# sidecar WS 地址（开发期 Web 直连；生产 Electron 经 IPC 转发，协议不变）
NEXT_PUBLIC_SIDECAR_WS=ws://localhost:8001/ws

# assistant-ui 云端会话持久化（cloud.assistant-ui.com 注册后填写；留空 = 本地会话）
# NEXT_PUBLIC_ASSISTANT_BASE_URL=

# 模型服务密钥（assistant-ui Thread 使用，按需配置）
# OPENAI_API_KEY=
