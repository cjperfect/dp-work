{
  "name": "@dp-work/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "pnpm typecheck && vite build",
    "start": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "routes:generate": "tsr generate",
    "routes:watch": "tsr watch",
    "typecheck": "pnpm --filter @dp-work/contracts build && pnpm routes:generate && tsc --noEmit",
    "test:auth": "tsx --test src/features/auth/tests/*.test.mjs",
    "test:knowledge": "tsx --test src/features/knowledge/tests/*.test.mjs",
    "test:knowledge-api": "tsx --test src/features/knowledge/tests/create-knowledge-api.test.mjs",
    "test:meetings": "tsx --test src/features/meetings/tests/*.test.mjs",
    "test:agent": "tsx --test src/features/agent/tests/*.test.mjs",
    "test:mock": "tsx --test src/features/auth/tests/*.test.mjs src/features/agent/tests/local-session.test.mjs src/features/knowledge/tests/mock-repository.test.mjs src/features/meetings/tests/generate-minutes.test.mjs src/features/meetings/tests/minutes-view.test.mjs",
    "test:asr": "tsx --test src/features/meetings/tests/asr-protocol.test.mjs src/features/meetings/tests/pcm-recorder.test.mjs",
    "test:settings": "tsx --test src/features/settings/tests/*.test.mjs"
  },
  "dependencies": {
    "@assistant-ui/react": "^0.15.30",
    "@assistant-ui/react-markdown": "^0.14.24",
    "@assistant-ui/react-syntax-highlighter": "^0.14.7",
    "@base-ui/react": "^1.9.0",
    "@blocknote/core": "^0.56.0",
    "@blocknote/mantine": "^0.56.0",
    "@blocknote/react": "^0.56.0",
    "@dp-work/contracts": "workspace:*",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-switch": "^1.4.1",
    "@tanstack/react-router": "^1.170.46",
    "@xyflow/react": "^12.12.0",
    "assistant-stream": "^0.3.54",
    "axios": "^1.20.0",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.0",
    "es-toolkit": "^1.52.0",
    "jose": "^6.2.13",
    "lucide-react": "^1.59.0",
    "mermaid": "^12.2.0",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-syntax-highlighter": "^16.1.2",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.5.0",
    "simple-icons": "^16.35.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "tw-shimmer": "^0.4.14",
    "y-prosemirror": "^1.3.7",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.33",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@tanstack/router-cli": "^1.167.46",
    "@tanstack/router-plugin": "^1.168.48",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@vitejs/plugin-react": "^4.3.4",
    "fake-indexeddb": "^6.2.6",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^6.0.0"
  }
}
