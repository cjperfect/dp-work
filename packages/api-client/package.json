{
  "name": "@dp-work/api-client",
  "version": "0.1.0",
  "private": true,
  "description": "桌面端与 Web 共用的 TS API 客户端",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsup"
  },
  "dependencies": {
    "@dp-work/contracts": "workspace:*"
  },
  "devDependencies": {
    "tsup": "^9.0.0",
    "typescript": "^6.0.0"
  },
  "module": "./dist/index.mjs",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  }
}
