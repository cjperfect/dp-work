{
  "name": "dp-work",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.25.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @dp-work/web dev",
    "dev:web": "pnpm --filter @dp-work/web dev",
    "build": "pnpm --filter @dp-work/web build",
    "start": "pnpm --filter @dp-work/web start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "prepare": "husky",
    "dev:api": "cd services/api && .venv/bin/python -m uvicorn src.main:app --reload --host 127.0.0.1 --port 8000",
    "dev:https": "pnpm --filter @dp-work/web dev:https",
    "migrate": "cd services/api && .venv/bin/python -m alembic upgrade head",
    "migrate:generate": "cd services/api && .venv/bin/python -m alembic revision --autogenerate",
    "migrate:revert": "cd services/api && .venv/bin/python -m alembic downgrade -1",
    "migrate:check": "cd services/api && .venv/bin/python -m alembic check",
    "migrate:current": "cd services/api && .venv/bin/python -m alembic current",
    "migrate:history": "cd services/api && .venv/bin/python -m alembic history",
    "dev:desktop": "pnpm --filter @dp-work/desktop dev",
    "build:desktop": "pnpm --filter @dp-work/desktop build && pnpm --filter @dp-work/desktop build:web && pnpm --filter @dp-work/desktop build:sidecar",
    "package:desktop": "pnpm --filter @dp-work/desktop package",
    "package:desktop:dir": "pnpm --filter @dp-work/desktop package:dir",
    "dev:sidecar": "cd services/sidecar && .venv/bin/python -m uvicorn src.main:app --reload --host 127.0.0.1 --port 8001",
    "test:sidecar": "cd services/sidecar && .venv/bin/python -m pytest tests -q",
    "setup:feishu-cli": "node node_modules/@larksuite/cli/scripts/install.js",
    "db:up": "docker-compose up -d postgres",
    "db:down": "docker-compose down",
    "db:logs": "docker-compose logs -f postgres",
    "dev:workers": "cd services/api && .venv/bin/python -m src.infrastructure.tasks.workers",
    "mq:up": "docker-compose up -d rabbitmq",
    "mq:logs": "docker-compose logs -f rabbitmq",
    "eval:smoke": "cd services/sidecar && .venv/bin/python -m evals.run --smoke",
    "eval:live": "cd services/sidecar && .venv/bin/python -m evals.run --live"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,tsx}": [
      "eslint --fix --no-warn-ignored"
    ],
    "*.{js,mjs,cjs,ts,tsx,json,md,css,html,yml,yaml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^16.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0"
  },
  "dependencies": {
    "@larksuite/cli": "1.0.98"
  }
}
